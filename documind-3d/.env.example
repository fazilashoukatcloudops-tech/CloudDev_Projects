NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Kam az kam 32 chars. Yeh placeholder production mein reject hota hai.
JWT_SECRET=change-me-generate-a-long-random-string-min-32-chars
JWT_EXPIRES_DAYS=7

# HTTPS par true. HTTP par true karoge to login cookie set hi nahi hogi.
COOKIE_SECURE=false

BCRYPT_ROUNDS=12
