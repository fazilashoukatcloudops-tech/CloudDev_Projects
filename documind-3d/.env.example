NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-generate-a-long-random-string-min-32-chars
JWT_EXPIRES_DAYS=7
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# Database (compose.yaml ke defaults se match karta hai, sirf local dev)
DATA_STORE=postgres
DATABASE_URL=postgresql://documind:documind_dev_password@localhost:5432/documind?schema=public

# Upload (Day 8 par STORAGE_DRIVER=s3)
STORAGE_DRIVER=local
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10
