# Vite env variables BUILD TIME par bundle mein bake hote hain.
# Variable badalne ke baad dobara `npm run build` zaroori hai.

# Option A (recommended, Day 17): same-origin. Nginx /api ko API container par proxy karega.
# CORS aur cookies ka masla nahi aata.
VITE_API_BASE_URL=/api/v1

# Option B: alag API domain. API ke CORS_ORIGIN mein web ka exact origin dena zaroori hai.
# VITE_API_BASE_URL=https://api.example.com/api/v1
