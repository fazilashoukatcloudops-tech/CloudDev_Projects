pipeline {
    agent any
    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }


    stages {
        stage('Checkout') {
            steps {
                echo 'Code pulled from GitHub successfully.'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('documind-3d') {
                    echo 'Installing Node modules for API and Web...'
                    sh 'cd apps/api && npm ci --cache /var/jenkins_home/.npm-cache --prefer-offline'
                    sh 'cd apps/web && npm ci --cache /var/jenkins_home/.npm-cache --prefer-offline'
                }
            }
        }

        stage('Quality Check (Lint, Typecheck, Tests)') {
            steps {
                dir('documind-3d') {
                    echo 'Running checks...'
                    sh 'cd apps/api && npm run check'
                    sh 'cd apps/web && npm run check'
                }
            }
        }

        stage('Security') {
            steps {
                // npm audit: high/critical -> UNSTABLE (non-blocking)
                dir('documind-3d') {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        sh '''
                            rc=0
                            (cd apps/api && npm audit --omit=dev --audit-level=high) || rc=1
                            (cd apps/web && npm audit --omit=dev --audit-level=high) || rc=1
                            exit $rc
                        '''
                    }
                }
                // gitleaks: any secret -> FAILURE (hard stop)
                sh '/var/jenkins_home/tools/gitleaks detect --source . --config .gitleaks.toml --redact --no-banner --exit-code 1 --no-git'
            }
        }

        stage('Build Docker Images') {
            steps {
                dir('documind-3d') {
                    echo 'Building production Docker images...'
                    sh 'sudo /usr/local/bin/docker compose build'
                }
            }
        }
    }

    post {
        success {
            echo '? Pipeline Successful: All tests passed and Docker images built!'
        }
        failure {
            echo '? Pipeline Failed: Check the logs above.'
        }
    }
}
